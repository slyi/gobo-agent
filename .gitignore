# Build output and local state (machine-generated, never commit)
*.sb3
debug/
tools/scratchvm-profile/
tools/scratchvm-profiles/
tools/scratchhost/node_modules/
tools/scratchhost/vendor/
/.tools/
tools/.gsdev-port
__pycache__/

# VS Code extension: source and the shipped VSIX are committed so end users need no
# Node; only node_modules/ and stray VSIXes elsewhere are ignored.
vscode-extension/node_modules/
*.vsix
!vscode-extension/*.vsix

# Local Kilo state (agent-manager sessions, local settings)
/.kilo/

# Archived local-only plans, handoffs and deprecated investigation harnesses
# (moved out of the working tree; never shipped)
archive/


# Local planning/handoff notes (not part of the shipped repo).
/plans/
# Listed explicitly rather than with a blanket `*.md`: that pattern silently
# dropped shipped docs such as tools/*.md, and would swallow a future
# LICENSE.md / CONTRIBUTING.md / docs/**. README.md, AGENTS.md and tools/*.md
# are intended to ship.
handoff*.md
handover-*.md
plan-*.md
rtcfinding.md
AGENTS-internal.md
agents_staging.txt
*_review.txt

# Local perf-investigation reference screenshots now live in archive/ (see above).

# Local-only fixture/demo projects and test suites (not part of the shipped repo)
examples/
tests/

# Deprecated investigation harnesses (blockcost, gsbench, benchmarks/assignment)
# now live under archive/ above; keep them out of the working tree.

# Maintainer-only checks, not used by end users or by agents iterating a project
# (run them locally when changing the harness itself):
#   test_perf_controls      perf-run setup (dialogs/occlusion/ports), no browser
#   test_procedure_profile  profiler attribution invariant, end to end
#   benchmarks/profiling    the fixture that test needs
tools/test_perf_controls.py
tools/test_procedure_profile.py
tools/test_bridge_targets.py
tools/test_profiler_aggregation.py
tools/measure_overhead.py
tools/benchmarks/profiling/
tools/benchmarks/hatsAgg/
tools/benchmarks/cloneAgg/

# OS cruft
.DS_Store
Thumbs.db
desktop.ini
tools/benchmarks/waitsAgg/
tools/test_profiler_waits.py
tools/test_preflight.py
profiler-handover.md
